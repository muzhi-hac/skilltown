    "screening": {
      "version": "1.0.0",
      "title": "先试试我会什么",
      "category": "ethics_compliance",
      "estimated_minutes": 2,
      "available_modes": [
        "screening"
      ],
      "skills": [
        "clarify_context",
        "conflict_awareness",
        "communicate_boundary"
      ],
      "start_node": "screen_clarify",
      "nodes": {
        "screen_clarify": {
          "npc_id": "mira",
          "category": "ethics_compliance",
          "text": "第 1 题（共 3 题）。同事说：“客户请我们吃饭，你也一起来吧。”在决定去不去之前，你最需要先弄清哪一项？",
          "allow_text": true,
          "choices": [
            {
              "id": "who_pays_pending",
              "label": "谁付款，以及是否涉及你正在审批的事项。"
            },
            {
              "id": "restaurant_level",
              "label": "餐厅档次和人均消费。"
            },
            {
              "id": "headcount",
              "label": "一共有多少同事参加。"
            }
          ],
          "branches": {
            "who_pays_pending": {
              "next_node": "screen_conflict",
              "effect": "none",
              "skill_id": "clarify_context",
              "state": "pass",
              "interpretation": "先补齐付款方与待决事项，再做判断。",
              "feedback": "对：先看付款方和与待决决定的关系。",
              "policy_clause_ids": [
                "ETH-03"
              ]
            },
            "restaurant_level": {
              "next_node": "screen_conflict",
              "effect": "none",
              "skill_id": "clarify_context",
