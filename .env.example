# 复制为 .env，填入一个凭据，然后照常启动服务端 —— server/main.py 会自动读取本文件。
# .env 已被 .gitignore 忽略，也不会进镜像；线上配置来自 fly.toml 和 Fly secrets。
# 真实环境变量优先级更高：shell 里已经设过的名字，这里不会覆盖。

# --- 模型：自由回答评估 + 施压角色的台词（同一次调用的两个字段）---

# 填下面任意一种凭据即可；两种都不填时自动退回确定性评估，不会报错。
# 1) 官方 Anthropic key（走 x-api-key）
ANTHROPIC_API_KEY=
# 2) 或 Anthropic 兼容网关（走 Bearer）；用哪种就填哪种，不要两种都填。
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# 总开关。留 true 即可：没有凭据时依然自动走确定性评估。
# 只有当某个网关明确不放行、你想省掉每次作答的等待时，才改回 false。
SKILLTOWN_MODEL_ENABLED=true

# 线上用 sonnet 是因为它明显更快（opus 实测每轮约 12 秒，一段四轮施压太久）。
SKILLTOWN_MODEL=claude-sonnet-5

# 每个访客会话的模型调用上限。一段最多四轮的施压最多花 4 次，所以 40 约等于 10 个情境。
SKILLTOWN_MODEL_CALL_BUDGET=40

# 单次调用超时（秒），SDK 内部最多重试一次。
SKILLTOWN_MODEL_TIMEOUT=20

# 某些兼容网关按 User-Agent 过滤，拒绝 SDK 的默认标识。官方 key 不要设这一项。
# SKILLTOWN_MODEL_USER_AGENT=curl/8.4.0

# --- 服务端 ---

# 本机随便放一个路径；data/ 已被 gitignore。线上是挂载卷 /data/skilltown.sqlite3。
DATABASE_PATH=data/dev.sqlite3

# 同源部署留空即可（默认就会挂载 client/dist）。只想跑 API 时填一个不存在的路径。
WEB_DIR=

# 同源时留空。只有前后端分开跑（npm run dev 在 5173）时才需要填来源。
CORS_ORIGINS=

# 稠密检索起不来就拒绝启动。本机没有 models/potion-base-8M 时保持 false，
# 检索会降级为纯 BM25 并在 /ready 里如实说明。
SKILLTOWN_REQUIRE_DENSE=false
