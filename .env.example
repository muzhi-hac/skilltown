# 复制为 .env，填入一个凭据，然后照常启动服务端 —— server/main.py 会自动读取本文件。
# .env 已被 .gitignore 忽略，也不会进镜像；线上配置来自 fly.toml 和 Fly secrets。
# 真实环境变量优先级更高：shell 里已经设过的名字，这里不会覆盖。

# --- 模型：自由回答评估 + 施压角色的台词（同一次调用的两个字段）---

# 填下面任意一种凭据即可。哪种都不填时自动退回确定性评估，不会报错。
# 填了哪种就自动用哪种，不需要额外声明 provider。

# 1) OpenAI（或任何 OpenAI 兼容网关：OpenRouter、vLLM、DeepSeek、通义…）
OPENAI_API_KEY=
# 自建或第三方网关才需要填，官方留空。要带到 /chat/completions 之前那一段，
# 例如 https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# OPENAI_ORGANIZATION=

# 2) Anthropic 官方 key（走 x-api-key）
ANTHROPIC_API_KEY=
# 3) 或 Anthropic 兼容网关（走 Bearer）
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# 两类凭据都填了才需要这一项：openai / claude。
# SKILLTOWN_MODEL_PROVIDER=openai

# 总开关。留 true 即可：没有凭据时依然自动走确定性评估。
# 只有当某个网关明确不放行、你想省掉每次作答的等待时，才改回 false。
SKILLTOWN_MODEL_ENABLED=true

# 留空则按凭据取默认值（OpenAI: gpt-4o-mini，Anthropic: claude-opus-5）。
# 建议明确填成你这把 key 真正有权限的模型。按每百万 token 计价，从便宜到贵：
#   claude-haiku-4-5  $1 / $5    实测每轮约 9 秒，够用，目前用它
#   claude-sonnet-5   $2 / $10   判定更细
#   claude-opus-5     $5 / $25   每轮约 12 秒，四轮太久
# 便宜的模型不接受 effort 参数，适配器会自动去掉并记住，不用改配置。
SKILLTOWN_MODEL=claude-haiku-4-5

# 每个访客会话的模型调用上限。一段最多四轮的施压最多花 4 次，所以 40 约等于 10 个情境。
SKILLTOWN_MODEL_CALL_BUDGET=40

# 单次调用超时（秒），SDK 内部最多重试一次。
SKILLTOWN_MODEL_TIMEOUT=20

# 某些 Anthropic 兼容网关按 User-Agent 过滤，拒绝 SDK 的默认标识。
# 官方 key 和 OpenAI 那条路都不要设这一项。
# SKILLTOWN_MODEL_USER_AGENT=curl/8.4.0

# --- 服务端 ---

# 本机随便放一个路径；data/ 已被 gitignore。线上是挂载卷 /data/skilltown.sqlite3。
DATABASE_PATH=data/dev.sqlite3

# 同源部署留空即可（默认就会挂载 client/dist）。只想跑 API 时填一个不存在的路径。
WEB_DIR=

# 同源时留空。只有前后端分开跑（npm run dev 在 5173）时才需要填来源。
CORS_ORIGINS=

# 稠密检索起不来就拒绝启动。本机没有 models/potion-base-8M 时保持 false，
# 检索会降级为纯 BM25 并在 /ready 里如实说明。
SKILLTOWN_REQUIRE_DENSE=false
