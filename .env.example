# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交真实值。

# --- 模型（自由回答评估）---
# 未设置时后端使用确定性 fallback 评估器，并在响应里标注 feedback_mode=fallback。
ANTHROPIC_API_KEY=
SKILLTOWN_MODEL=claude-sonnet-5
# 以下两项在模型适配器落地后生效（当前代码尚未读取）：每会话调用预算与单条消息长度上限。
SKILLTOWN_MODEL_CALL_BUDGET=40
SKILLTOWN_MAX_TEXT_CHARS=1000

# --- 服务端 ---
# 生产使用挂载的持久卷路径，例如 /data/skilltown.sqlite3
DATABASE_PATH=data/skilltown.sqlite3
# 同源部署时留空即可；跨源调试时填页面来源，逗号分隔。
CORS_ORIGINS=http://localhost:8060
# 本机同源调试：把 Godot 构建挂到 / 。留空则只提供 API。
WEB_DIR=

# --- Cloudflare Pages（前端）---
# Pages 项目的环境变量，不属于本文件；此处仅作记录：
# API_ORIGIN=https://<能跑 Python 的源站或 cloudflared 隧道地址>
